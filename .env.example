# Banco de dados. SQLite funciona localmente; em producao use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/marketing
DATABASE_URL=sqlite:///data/app.db

# Chave para assinar o cookie de sessao. Gere uma aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Opcional. Sem ela o filtro de relevancia usa so as regras de palavras-chave.
ANTHROPIC_API_KEY=
# Modelo barato do filtro de relevancia (roda em muitos atos por dia)
ANTHROPIC_MODEL=claude-haiku-4-5
# Modelo que escreve os rascunhos de post (roda so quando voce marca "Quero postar")
ANTHROPIC_DRAFT_MODEL=claude-opus-5-5

# Quantos dias para tras a primeira coleta busca
COLLECT_LOOKBACK_DAYS=7

# Em producao (site com HTTPS), marque o cookie de sessao como seguro:
COOKIE_SECURE=0

# Onde ficam o banco SQLite, o logo, as fotos de campo e as artes geradas
DATA_DIR=data

# Aviso por e-mail quando aparece norma muito relevante (opcional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAILS=
ALERT_MIN_RELEVANCE=60
AUTO_DRAFT=1
AUTO_DRAFT_MAX_PER_DAY=3
COLLECT_EVERY_DAYS=1
MIN_GAP_DAYS=2
